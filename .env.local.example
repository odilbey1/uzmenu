# ============================================================================
# QRMenu SaaS - Muhit o'zgaruvchilari (Environment Variables)
# Ushbu fayldan nusxa olib, '.env.local' nomli faylga saqlang va qiymatlarni kiriting
# ============================================================================

# 1. Supabase sozlamalari (Majburiy)
# Supabase Dashboard -> Project Settings -> API bo'limidan olasiz:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. OpenAI API kaliti (Keyingi bosqichda GPT-4o Vision orqali menyu tahlil qilish uchun)
OPENAI_API_KEY=sk-proj-...

# 3. Dastur domen manzili (Lokalda localhost:3000, productionda o'z domeningiz)
NEXT_PUBLIC_APP_URL=http://localhost:3000
